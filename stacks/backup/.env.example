# Optional. Copy to .env to override the defaults; read by scripts/backup.sh. Placeholders only; never commit .env.
# Quote values that contain spaces. Paths are on the host.

# Backup repository directory. Default: data/backup in this repository (gitignored; same disk as the data: a drill, not protection).
# A directory outside your home directory (for example an external disk) must also be shared with the Colima VM; see README.
NEXAHOME_BACKUP_DIR=/path/to/backup-directory

# File holding the repository password. Default: .config/restic-password in this repository (gitignored, mode 600, created by make backup-init).
NEXAHOME_RESTIC_PASSWORD_FILE=/path/to/restic-password

# UID the job runs as. It must be able to read the volumes; 1001 is the Actual stack's user.
NEXAHOME_BACKUP_UID=1001
