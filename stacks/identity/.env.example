# Copy to .env to override. Placeholders only; never commit .env.
# `make up` creates .env from this file and replaces each GENERATE with a random value
# (not shown). Copy ENCRYPTION_KEY from .env into your password manager: a restored
# database is unusable without it.

# Must equal the values in stacks/edge/.env.
NEXAHOME_DOMAIN=nexahome.localhost
EDGE_PORT=8088

# Encrypts sensitive data in the database.
ENCRYPTION_KEY=GENERATE
