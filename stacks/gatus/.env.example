# Copy to .env to override. Placeholders only; never commit .env.
# Must equal the values in stacks/edge/.env.
NEXAHOME_DOMAIN=nexahome.localhost
EDGE_PORT=8088

# Notifications via ntfy (https://ntfy.sh, free, no account). Empty topic = off, nothing leaves the machine.
# To turn on: set NTFY_TOPIC=GENERATE (make up creates a random topic; open this .env to read it) and
# subscribe to that topic in the ntfy app. The topic is the secret: anyone who knows it can read and post.
# Alert text (target name, status, time, URL) is sent to NTFY_URL; point it at your own ntfy server to keep it local.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
