# Copy to .env to override. Placeholders only; never commit .env.
# `make up` creates .env from this file.

# Base domain for every app hostname (id.<domain>, ...). Keep it equal in every stack's .env.
# *.localhost resolves to 127.0.0.1 in browsers and curl; changing it re-enrolls passkeys.
NEXAHOME_DOMAIN=nexahome.localhost

# Port the edge listens on, on 127.0.0.1 only and inside the network. The OIDC issuer URL
# contains it. Keep it equal in every stack's .env.
EDGE_PORT=8088
