# Copy to .env to override. Placeholders only; never commit .env.

# Host port, published on 127.0.0.1 only.
ACTUAL_PORT=5006

# Single sign-on through the identity stack (optional; leave the secret empty for password login only).
# Must equal the values in stacks/edge/.env.
NEXAHOME_DOMAIN=nexahome.localhost
EDGE_PORT=8088
# Client id and secret of the client "actual" in the provider (README, "Sign in with SSO").
ACTUAL_OPENID_CLIENT_ID=actual
ACTUAL_OPENID_CLIENT_SECRET=
# login = a user is created in Actual at first sign-in; manual = the owner adds each user first.
ACTUAL_USER_CREATION_MODE=login
# Seconds an Actual login stays valid (default there: never). One day, like the provider session.
ACTUAL_TOKEN_EXPIRATION=86400
